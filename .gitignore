__pycache__/
*.pyc
*.tmp
.pytest_cache/
.ipynb_checkpoints/
.venv/
venv/
models/
data/raw/
data/processed/
# data/manifest.jsonl IS versioned: it pins id, version and md5 of every dataset

# Results. Everything here can be regenerated, but the full run costs ~6 h of CPU.
# Versioned: what the statistics and the results page need, i.e. the per-instance
# summaries and the manifest of the full run and of the CARLA check (~12 MB).
# The full run is results/full_rerun (2026-11-22, on the committed code). The first run,
# results/full, was removed after the C4 check; it is in the git history (commit 6a04788).
# Not versioned: runs/ (one row per counterfactual, ~200 MB), logs, notes and the
# smaller demo runs (curve_demo, simulation_quick, smoke), which the notebooks rebuild.
results/*
!results/carla_check/
results/carla_check/*
!results/carla_check/summary/
!results/carla_check/manifest.jsonl
# Re-run of the full grid on the committed code (2026-11-22, concern C4) and the full simulation.
!results/full_rerun/
results/full_rerun/*
!results/full_rerun/summary/
!results/full_rerun/manifest.jsonl
!results/full_rerun/compare_with_full.csv
!results/simulation/
results/simulation/*
!results/simulation/summary/
!results/simulation/manifest.jsonl
